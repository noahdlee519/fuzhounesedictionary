# Copy to ".env.local" and fill in from Supabase → Project Settings → API.
# Never commit .env.local.

# Public — safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — SERVER ONLY. Bypasses RLS. Used for moderation actions & CSV import.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Where the app is reachable (used to build the OAuth redirect).
# Local dev: http://localhost:3000  ·  Production: your Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
